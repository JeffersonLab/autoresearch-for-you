+void JArrow::ClearOutputs(OutputData& outputs, size_t output_count) {
+    // Recycling an event runs JEvent::Clear(), whose JFactorySet::Clear() deletes every
+    // object inserted into it - thousands of deallocations for a parsed EVIO block.
+    // JEventPool does that from inside Push(), which the engine calls with its mutex
+    // held, so every worker serializes through one lock. Doing it here instead, after
+    // Fire() and before Push(), keeps it off the mutex while the outputs are still owned
+    // by this worker alone.
+    //
+    // Events that still have children are deliberately skipped: a child may hold a
+    // pointer into data its parent inserted, so only the pool may clear a parent, once
+    // the last child has finished. Skipping is always safe because the pool clears
+    // whatever reaches it uncleared; the second Clear() there is then a cheap no-op,
+    // since Clear() nulls mEventSource (FinishEvent cannot fire twice) and an emptied
+    // JFactorySet has nothing left to delete.
+    for (size_t output = 0; output < output_count; ++output) {
+        JEvent* event = outputs[output].first;
+        Port& port = GetPort(outputs[output].second);
+        if (port.GetQueue() == nullptr && port.GetPool() != nullptr && event->GetChildCount() == 0) {
+            event->Clear();
+        }
+    }
+}
 
